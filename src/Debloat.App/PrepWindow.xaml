<ui:FluentWindow x:Class="Debloat.App.PrepWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Preparando" Width="520" Height="600" MinWidth="420" MinHeight="360"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Preparando" ShowMinimize="False" ShowMaximize="False" />

    <ScrollViewer Grid.Row="1" Padding="16,8">
      <ItemsControl ItemsSource="{Binding PrepItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Symbol="CheckmarkCircle24" Filled="True" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                             Visibility="{Binding Done, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock Grid.Column="2" Text="{Binding State}" Margin="12,0,0,0"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="16,8,16,16">
      <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="4" Margin="0,0,0,8" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
      <ui:Button Content="Fechar" HorizontalAlignment="Right" Click="Close_Click" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
