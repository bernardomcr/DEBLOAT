<ui:FluentWindow x:Class="Debloat.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:Debloat.App"
                 Title="DEBLOAT" Width="960" Height="680" MinWidth="760" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Line" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="DEBLOAT — Windows 11 limpo, do jeito certo" />

    <TabControl Grid.Row="1" Margin="12,4,12,0">

      <!-- ESTE PC -->
      <TabItem Header="Este PC">
        <ScrollViewer Padding="16">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="O que encontrei neste PC" />
            <TextBlock Style="{StaticResource Hint}" Text="O preset se ajusta ao hardware. Nada aqui é apagado sem você confirmar na aba Criar." />
            <ui:Card Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Style="{StaticResource Line}" FontWeight="SemiBold" Text="{Binding MachineKind}" />
                <TextBlock Style="{StaticResource Line}" Text="{Binding PowerText}" />
                <TextBlock Style="{StaticResource Line}" Text="{Binding HelloText}" />
                <TextBlock Style="{StaticResource Line}" Text="{Binding PenText}" />
              </StackPanel>
            </ui:Card>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- WINDOWS -->
      <TabItem Header="Windows">
        <ScrollViewer Padding="16">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Windows 11" />
            <TextBlock Style="{StaticResource Hint}" Text="Windows 11 Pro em português (Brasil), teclado ABNT2, horário de Brasília. Baixado direto dos servidores da Microsoft, com conferência de integridade." />
            <ui:Button Content="Baixar o Windows 11 mais recente" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding DownloadWindowsCommand}" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding WindowsVersion}" Margin="0,0,0,24" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Conta" />
            <TextBlock Style="{StaticResource Hint}" Text="Conta local de administrador, sem senha, com login automático." />
            <ui:TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Nome de usuário" Margin="0,0,0,24" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="DNS" />
            <TextBlock Style="{StaticResource Hint}" Text="Aplicado em todas as placas de rede, com DNS criptografado (DoH)." />
            <ComboBox ItemsSource="{Binding DnsOptions}" SelectedItem="{Binding SelectedDns}" DisplayMemberPath="Label" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- DEBLOAT -->
      <TabItem Header="Debloat">
        <ScrollViewer Padding="16">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Preset Recomendado" />
            <TextBlock Style="{StaticResource Hint}" Text="Já vem pronto. Cada escolha foi pesada entre o que se ganha e o que se perde." />
            <ui:Card Margin="0,0,0,16">
              <ItemsControl ItemsSource="{Binding PresetHighlights}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,4">
                      <ui:SymbolIcon Symbol="Checkmark24" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Visual" />
            <ui:CardControl Header="Modo escuro" Margin="0,0,0,4"><ui:ToggleSwitch IsChecked="{Binding DarkMode}" /></ui:CardControl>
            <ui:CardControl Header="Barra de tarefas à esquerda" Margin="0,0,0,4"><ui:ToggleSwitch IsChecked="{Binding LeftTaskbar}" /></ui:CardControl>
            <ui:CardControl Header="Menu de contexto clássico (botão direito completo)" Margin="0,0,0,4"><ui:ToggleSwitch IsChecked="{Binding ClassicContextMenu}" /></ui:CardControl>
            <ui:CardControl Header="Visualizador de Fotos antigo como padrão" Margin="0,0,0,4"><ui:ToggleSwitch IsChecked="{Binding ClassicPhotoViewer}" /></ui:CardControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- APPS -->
      <TabItem Header="Apps">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Apps e pré-requisitos" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding AppsSummary, StringFormat='Instalados sozinhos no primeiro login. {0}.'}" />
          </StackPanel>
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:CardExpander Margin="0,0,0,6" IsExpanded="False">
                    <ui:CardExpander.Header>
                      <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Marcar/desmarcar todos" Appearance="Transparent" Margin="0,0,12,0"
                                   Command="{Binding ToggleAllCommand}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </DockPanel>
                    </ui:CardExpander.Header>
                    <ItemsControl ItemsSource="{Binding Apps}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox Width="270" Margin="0,2" IsChecked="{Binding IsSelected}" Content="{Binding Entry.Name}"
                                    ToolTip="{Binding Entry.Description}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ui:CardExpander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- BACKUP -->
      <TabItem Header="Backup">
        <ScrollViewer Padding="16">
          <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Levar para o Windows novo" />
            <TextBlock Style="{StaticResource Hint}" Text="Vai para a partição DEBLOAT-DADOS do pendrive quando você gravar, e volta sozinho para o lugar de origem no primeiro login do Windows novo. Wi-Fi, navegadores, ShareX e pastas chegam na próxima etapa." />
            <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Games24}" IsExpanded="True">
              <ui:CardExpander.Header>
                <DockPanel>
                  <ui:Button DockPanel.Dock="Right" Content="Marcar/desmarcar todos" Appearance="Transparent" Command="{Binding ToggleAllSavesCommand}" Margin="0,0,12,0" />
                  <ui:Button DockPanel.Dock="Right" Content="Procurar saves" Appearance="Primary" Command="{Binding ScanSavesCommand}" Margin="0,0,8,0" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Saves de jogos" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SavesSummary}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </DockPanel>
              </ui:CardExpander.Header>
              <ItemsControl ItemsSource="{Binding Saves}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                      <StackPanel>
                        <TextBlock Text="{Binding Game.Name}" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ui:CardExpander>
            <ui:CardControl Header="Redes Wi-Fi" Margin="0,0,0,4" Icon="{ui:SymbolIcon Wifi124}" IsEnabled="False" />
            <ui:CardControl Header="Navegadores" Margin="0,0,0,4" Icon="{ui:SymbolIcon Globe24}" IsEnabled="False">
              <TextBlock Text="Firefox volta logado. Chrome/Edge/Brave: extensões e favoritos; login e senhas pela sincronização da conta." TextWrapping="Wrap" MaxWidth="360" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </ui:CardControl>
            <ui:CardControl Header="Configuração do ShareX" Margin="0,0,0,4" Icon="{ui:SymbolIcon Screenshot24}" IsEnabled="False" />
            <ui:CardControl Header="Pastas (Área de Trabalho, Documentos, Downloads…)" Margin="0,0,0,4" Icon="{ui:SymbolIcon Folder24}" IsEnabled="False" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- CRIAR -->
      <TabItem Header="Criar">
        <ScrollViewer Padding="16">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Criar a instalação" />
            <TextBlock Style="{StaticResource Hint}" Text="Baixa o Windows (se ainda não baixou), monta a instalação com o seu preset, leva os drivers de rede/disco/chipset deste PC e grava tudo no pendrive. O pendrive é APAGADO." />
            <DockPanel Margin="0,0,0,8">
              <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshUsbCommand}" Margin="8,0,0,0" ToolTip="Procurar pendrives" />
              <ComboBox ItemsSource="{Binding UsbDrives}" SelectedItem="{Binding SelectedUsb}" DisplayMemberPath="Label" />
            </DockPanel>
            <WrapPanel>
              <ui:Button Content="Gravar pendrive" Appearance="Primary" Icon="{ui:SymbolIcon UsbStick24}" Click="WriteUsb_Click" Margin="0,0,8,8" />
              <ui:Button Content="Só montar a pasta" Icon="{ui:SymbolIcon Wrench24}" Command="{Binding BuildMediaCommand}" Margin="0,0,8,8" />
              <ui:Button Content="Só o autounattend.xml" Icon="{ui:SymbolIcon DocumentArrowDown24}" Command="{Binding ExportXmlCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Só aparecem pendrives USB. HDs, SSDs e o disco do Windows nunca entram na lista." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Margin="16,8,16,12">
      <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="4" Margin="0,0,0,6"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
