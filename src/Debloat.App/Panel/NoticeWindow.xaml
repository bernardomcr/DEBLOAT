<Window x:Class="Debloat.App.Panel.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DEBLOAT!" Width="380" Height="96" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource DebloatFont}" Cursor="Hand" MouseLeftButtonUp="Open_Click">
  <Border CornerRadius="10" Background="{DynamicResource DebloatBackground}" BorderBrush="{DynamicResource DebloatBorder}" BorderThickness="1"
          Padding="16,12,12,14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" Click="Hide_Click" ToolTip="Esconder (a instalação continua)" Cursor="Arrow"
                Width="24" Height="24" Padding="0" Margin="8,-4,0,0" Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource DebloatMuted}" FontSize="11" VerticalAlignment="Top" />
        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource DebloatText}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <TextBlock Grid.Row="1" Text="{Binding Detail}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource DebloatMuted}" TextTrimming="CharacterEllipsis" />
      <!-- Barra correndo (instalador não informa porcentagem); cheia quando termina. -->
      <Border Grid.Row="2" x:Name="Track" Height="4" Margin="0,10,4,0" VerticalAlignment="Bottom" CornerRadius="2"
              Background="{DynamicResource DebloatBorder}" ClipToBounds="True">
        <Canvas>
          <Border x:Name="Bar" Height="4" Width="90" CornerRadius="2" Background="{DynamicResource DebloatAccent}" />
        </Canvas>
      </Border>
    </Grid>
  </Border>
</Window>
