<ui:FluentWindow x:Class="Debloat.App.Panel.TweaksWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DEBLOAT! — Ajustes" Width="820" Height="680" MinWidth="640" MinHeight="480"
                 WindowStartupLocation="CenterScreen" Icon="/Assets/DEBLOAT.ico"
                 Background="{DynamicResource DebloatBackground}" FontFamily="{StaticResource DebloatFont}"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="DEBLOAT!" ShowMaximize="False">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="/Assets/debloat-icon-40.png" Width="20" Height="20" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <TextBlock Grid.Row="1" Style="{StaticResource PageTitle}" Text="Ajustes aplicados" Margin="32,16,32,12" />

    <ScrollViewer Grid.Row="2" Padding="32,0,32,16">
      <ItemsControl ItemsSource="{Binding Tweaks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource DebloatBorder}" BorderThickness="0,0,0,1" MinHeight="56" Padding="0,8">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Desfeito" VerticalAlignment="Center" Foreground="{DynamicResource DebloatMuted}"
                             Visibility="{Binding Undone, Converter={StaticResource BoolToVisibility}}" />
                  <ui:Button Content="Desfazer" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UndoCommand}"
                             Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource DebloatText}" />
                  <TextBlock Text="{Binding Group}" Style="{StaticResource Secondary}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="3" BorderBrush="{DynamicResource DebloatBorder}" BorderThickness="0,1,0,0" Padding="32,10,32,12">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource DebloatMuted}" />
    </Border>
  </Grid>
</ui:FluentWindow>
