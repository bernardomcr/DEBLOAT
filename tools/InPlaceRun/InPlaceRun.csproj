    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Debloat.Core\Debloat.Core.csproj" />
  </ItemGroup>

</Project>
