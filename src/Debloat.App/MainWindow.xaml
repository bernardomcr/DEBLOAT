<ui:FluentWindow x:Class="Debloat.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DEBLOAT" Width="980" Height="700" MinWidth="760" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="DEBLOAT" />

    <TabControl Grid.Row="1" Margin="12,4,12,0">

      <!-- WINDOWS -->
      <TabItem Header="Windows">
        <ScrollViewer Padding="16">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Windows 11" />
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Versão" />
                <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Idioma" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding WindowsVersion}" Margin="0,0,0,8" />
            <ui:Button Content="Baixar" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding DownloadWindowsCommand}" Margin="0,0,0,24" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Conta" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Nome de usuário" />
            <ui:TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="DNS" />
            <ComboBox ItemsSource="{Binding DnsOptions}" SelectedItem="{Binding SelectedDns}" DisplayMemberPath="Label" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- DEBLOAT -->
      <TabItem Header="Debloat">
        <ScrollViewer Padding="16">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Preset Recomendado" />
            <ui:Card Margin="0,0,0,20">
              <ItemsControl ItemsSource="{Binding PresetHighlights}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,4">
                      <ui:SymbolIcon Symbol="Checkmark24" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ui:Card>

            <DockPanel Margin="0,0,0,10">
              <ui:Button DockPanel.Dock="Right" Content="Voltar ao preset" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetTweaksCommand}" />
              <TextBlock Style="{StaticResource SectionTitle}" Text="Ajustes" Margin="0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding TweaksSummary}" Margin="12,4,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding TweakGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:CardExpander Margin="0,0,0,6" IsExpanded="False">
                    <ui:CardExpander.Header>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </DockPanel>
                    </ui:CardExpander.Header>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3">
                            <StackPanel>
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="  · agressivo" Foreground="#E0A030" Visibility="{Binding Aggressive, Converter={StaticResource BoolToVisibility}}" />
                              </StackPanel>
                              <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ui:CardExpander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- APPS -->
      <TabItem Header="Apps">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Apps" Margin="0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding AppsSummary}" Margin="12,4,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </DockPanel>
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:CardExpander Margin="0,0,0,6" IsExpanded="False">
                    <ui:CardExpander.Header>
                      <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Marcar/desmarcar todos" Appearance="Transparent" Margin="0,0,12,0"
                                   Command="{Binding ToggleAllCommand}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </DockPanel>
                    </ui:CardExpander.Header>
                    <ItemsControl ItemsSource="{Binding Apps}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox Width="280" Margin="0,2" IsChecked="{Binding IsSelected}" Content="{Binding Entry.Name}"
                                    ToolTip="{Binding Entry.Description}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ui:CardExpander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- BACKUP -->
      <TabItem Header="Backup">
        <ScrollViewer Padding="16">
          <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Backup" />
            <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Games24}" IsExpanded="True">
              <ui:CardExpander.Header>
                <DockPanel>
                  <ui:Button DockPanel.Dock="Right" Content="Marcar/desmarcar todos" Appearance="Transparent" Command="{Binding ToggleAllSavesCommand}" Margin="0,0,12,0" />
                  <ui:Button DockPanel.Dock="Right" Content="Procurar saves" Appearance="Primary" Command="{Binding ScanSavesCommand}" Margin="0,0,8,0" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Saves de jogos" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SavesSummary}" Style="{StaticResource Secondary}" />
                  </StackPanel>
                </DockPanel>
              </ui:CardExpander.Header>
              <ItemsControl ItemsSource="{Binding Saves}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                      <StackPanel>
                        <TextBlock Text="{Binding Game.Name}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ui:CardExpander>

            <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Folder24}" IsExpanded="True">
              <ui:CardExpander.Header>
                <DockPanel>
                  <ui:Button DockPanel.Dock="Right" Content="Adicionar pasta" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding AddFolderCommand}" Margin="0,0,12,0" />
                  <TextBlock Text="Programas e pastas" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
              </ui:CardExpander.Header>
              <ItemsControl ItemsSource="{Binding Migration}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                      <StackPanel>
                        <TextBlock Text="{Binding Item.Name}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ui:CardExpander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- CRIAR -->
      <TabItem Header="Criar">
        <ScrollViewer Padding="16">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Criar instalação" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Pendrive" />
            <DockPanel Margin="0,0,0,12">
              <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshUsbCommand}" Margin="8,0,0,0" ToolTip="Procurar pendrives" />
              <ComboBox ItemsSource="{Binding UsbDrives}" SelectedItem="{Binding SelectedUsb}" DisplayMemberPath="Label" />
            </DockPanel>
            <WrapPanel>
              <ui:Button Content="Gravar pendrive" Appearance="Primary" Icon="{ui:SymbolIcon UsbStick24}" Click="WriteUsb_Click" Margin="0,0,8,8" />
              <ui:Button Content="Gerar ISO" Icon="{ui:SymbolIcon Album24}" Command="{Binding BuildIsoCommand}" Margin="0,0,8,8" />
              <ui:Button Content="Só montar a pasta" Icon="{ui:SymbolIcon Wrench24}" Command="{Binding BuildMediaCommand}" Margin="0,0,8,8" />
              <ui:Button Content="Só o autounattend.xml" Icon="{ui:SymbolIcon DocumentArrowDown24}" Command="{Binding ExportXmlCommand}" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Margin="16,8,16,12">
      <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="4" Margin="0,0,0,6"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
