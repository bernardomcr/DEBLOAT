<ui:FluentWindow x:Class="Debloat.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:Debloat.App"
                 Title="DEBLOAT!" Width="1040" Height="720" MinWidth="880" MinHeight="640"
                 WindowStartupLocation="CenterScreen" Icon="Assets/DEBLOAT.ico"
                 Background="{DynamicResource DebloatBackground}" FontFamily="{StaticResource DebloatFont}"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="DEBLOAT!">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="Assets/debloat-icon-40.png" Width="20" Height="20" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Border Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,24,0" Panel.ZIndex="1" Padding="12,6"
            CornerRadius="6" Background="{DynamicResource DebloatAccentSoft}"
            Visibility="{Binding UpdateText, Converter={StaticResource NotNullToVisibility}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center" Foreground="{DynamicResource DebloatText}" Margin="0,0,12,0" />
        <ui:Button Content="Baixar" Appearance="Primary" Command="{Binding OpenUpdateCommand}" Padding="10,4" />
      </StackPanel>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="1" Style="{StaticResource DebloatTabs}" ItemContainerStyle="{StaticResource DebloatTab}">

      <!-- WINDOWS -->
      <TabItem Header="Windows">
        <ScrollViewer Padding="32,24,32,32">
          <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Windows 11" />
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Versão" />
                <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Build" />
                <ComboBox ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedBuild}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Idioma" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
              </StackPanel>
              <ui:Button Grid.Column="6" VerticalAlignment="Bottom" Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="Atualizar"
                         Command="{Binding RefreshBuildsCommand}" Padding="8" MinHeight="34" />
            </Grid>
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding WindowsVersion}" Margin="0,0,0,8" />
            <ui:Button Content="Baixar" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding DownloadWindowsCommand}" Margin="0,0,0,24" />

            <TextBlock Style="{StaticResource GroupTitle}" Text="Conta" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Nome de usuário" />
            <ui:TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24" />

            <TextBlock Style="{StaticResource GroupTitle}" Text="DNS" />
            <ComboBox ItemsSource="{Binding DnsOptions}" SelectedItem="{Binding SelectedDns}" DisplayMemberPath="Label" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- DEBLOAT -->
      <TabItem Header="Debloat">
        <ScrollViewer Padding="32,24,32,32">
          <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Preset Recomendado" />
            <Border Margin="0,0,0,24" Padding="20,18" CornerRadius="10" Background="{DynamicResource DebloatAccentSoft}">
              <DockPanel>
                <Image DockPanel.Dock="Left" Source="Assets/debloat-icon-64.png" Width="32" Height="32" Margin="0,2,16,0" VerticalAlignment="Top" />
              <ItemsControl ItemsSource="{Binding PresetHighlights}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,4">
                      <ui:SymbolIcon Symbol="Checkmark24" Foreground="{DynamicResource DebloatAccent}" Margin="0,0,10,0" VerticalAlignment="Top" />
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource DebloatText}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </DockPanel>
            </Border>

            <DockPanel Margin="0,0,0,10">
              <ui:Button DockPanel.Dock="Right" Content="Voltar ao preset" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetTweaksCommand}" />
              <TextBlock Style="{StaticResource GroupTitle}" Text="Ajustes" Margin="0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding TweaksSummary}" Margin="12,4,0,0" VerticalAlignment="Center" Foreground="{DynamicResource DebloatMuted}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding TweakGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:CardExpander Margin="0,0,0,6" IsExpanded="False">
                    <ui:CardExpander.Header>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Foreground="{DynamicResource DebloatMuted}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </DockPanel>
                    </ui:CardExpander.Header>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3">
                            <StackPanel>
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="  · agressivo" Foreground="{DynamicResource DebloatWarning}" Visibility="{Binding Aggressive, Converter={StaticResource BoolToVisibility}}" />
                              </StackPanel>
                              <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ui:CardExpander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- APPS -->
      <TabItem Header="Apps">
        <Grid Margin="32,24,32,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <TextBlock Style="{StaticResource PageTitle}" Text="Apps" Margin="0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding AppsSummary}" Margin="12,4,0,0" VerticalAlignment="Center" Foreground="{DynamicResource DebloatMuted}" />
          </DockPanel>
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:CardExpander Margin="0,0,0,6" IsExpanded="False">
                    <ui:CardExpander.Header>
                      <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Marcar/desmarcar todos" Appearance="Transparent" Margin="0,0,12,0"
                                   Command="{Binding ToggleAllCommand}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Foreground="{DynamicResource DebloatMuted}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </DockPanel>
                    </ui:CardExpander.Header>
                    <ItemsControl ItemsSource="{Binding Apps}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox Width="280" Margin="0,2" IsChecked="{Binding IsSelected}" Content="{Binding Entry.Name}"
                                    ToolTip="{Binding Entry.Description}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ui:CardExpander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- BACKUP -->
      <TabItem Header="Backup">
        <ScrollViewer Padding="32,24,32,32">
          <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Backup" />
            <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Games24}" IsExpanded="True">
              <ui:CardExpander.Header>
                <DockPanel>
                  <ui:Button DockPanel.Dock="Right" Content="Marcar/desmarcar todos" Appearance="Transparent" Command="{Binding ToggleAllSavesCommand}" Margin="0,0,12,0" />
                  <ui:Button DockPanel.Dock="Right" Content="Procurar saves" Appearance="Primary" Command="{Binding ScanSavesCommand}" Margin="0,0,8,0" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Saves de jogos" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SavesSummary}" Style="{StaticResource Secondary}" />
                  </StackPanel>
                </DockPanel>
              </ui:CardExpander.Header>
              <ItemsControl ItemsSource="{Binding Saves}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                      <StackPanel>
                        <TextBlock Text="{Binding Game.Name}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ui:CardExpander>

            <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Apps24}" IsExpanded="True">
              <ui:CardExpander.Header>
                <DockPanel>
                  <ui:Button DockPanel.Dock="Right" Content="Procurar programas" Command="{Binding ScanProgramsCommand}" Margin="0,0,12,0" />
                  <TextBlock Text="Programas deste PC" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
              </ui:CardExpander.Header>
              <ItemsControl ItemsSource="{Binding Programs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                      <StackPanel>
                        <TextBlock Text="{Binding Program.Name}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ui:CardExpander>

            <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Folder24}" IsExpanded="True">
              <ui:CardExpander.Header>
                <DockPanel>
                  <ui:Button DockPanel.Dock="Right" Content="Adicionar pasta" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding AddFolderCommand}" Margin="0,0,12,0" />
                  <TextBlock Text="Configurações e pastas" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
              </ui:CardExpander.Header>
              <ItemsControl ItemsSource="{Binding Migration}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                      <StackPanel>
                        <TextBlock Text="{Binding Item.Name}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ui:CardExpander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- CRIAR -->
      <TabItem Header="Criar">
        <ScrollViewer Padding="32,24,32,32">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Criar instalação" />
            <TextBlock Style="{StaticResource GroupTitle}" Text="Este PC" />
            <ui:Button Content="Reinstalar sem pendrive" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Click="InPlace_Click" Margin="0,0,0,28" />

            <TextBlock Style="{StaticResource GroupTitle}" Text="Pendrive ou ISO" />
            <DockPanel Margin="0,0,0,12">
              <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshUsbCommand}" Margin="8,0,0,0" ToolTip="Procurar pendrives" />
              <ComboBox ItemsSource="{Binding UsbDrives}" SelectedItem="{Binding SelectedUsb}" DisplayMemberPath="Label" />
            </DockPanel>
            <WrapPanel>
              <ui:Button Content="Gravar pendrive" Icon="{ui:SymbolIcon UsbStick24}" Click="WriteUsb_Click" Margin="0,0,8,8" />
              <ui:Button Content="Gerar ISO" Icon="{ui:SymbolIcon Album24}" Command="{Binding BuildIsoCommand}" Margin="0,0,8,8" />
              <ui:Button Content="Só montar a pasta" Icon="{ui:SymbolIcon Wrench24}" Command="{Binding BuildMediaCommand}" Margin="0,0,8,8" />
              <ui:Button Content="Só o autounattend.xml" Icon="{ui:SymbolIcon DocumentArrowDown24}" Command="{Binding ExportXmlCommand}" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" BorderBrush="{DynamicResource DebloatBorder}" BorderThickness="0,1,0,0" Padding="32,10,32,12">
    <StackPanel>
      <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="4" Margin="0,0,0,6"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource DebloatMuted}" />
    </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
