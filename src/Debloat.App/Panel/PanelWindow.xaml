<ui:FluentWindow x:Class="Debloat.App.Panel.PanelWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DEBLOAT!" Width="820" Height="680" MinWidth="640" MinHeight="480"
                 WindowStartupLocation="CenterScreen" Icon="/Assets/DEBLOAT.ico"
                 Background="{DynamicResource DebloatBackground}" FontFamily="{StaticResource DebloatFont}"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="DEBLOAT!" ShowMaximize="False">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="/Assets/debloat-icon-40.png" Width="20" Height="20" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <StackPanel Grid.Row="1" Margin="32,16,32,8">
      <DockPanel>
        <ui:Button DockPanel.Dock="Right" x:Name="MinimizeButton" Content="Minimizar" Icon="{ui:SymbolIcon ArrowMinimize24}" Click="Minimize_Click" VerticalAlignment="Top" />
        <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" Text="Instalando seus apps" Margin="0,0,0,4" />
      </DockPanel>
      <TextBlock Text="{Binding Title}" Style="{StaticResource Secondary}" FontSize="14" Margin="0,0,0,12" />
      <Border x:Name="Track" Height="4" CornerRadius="2" Background="{DynamicResource DebloatBorder}" ClipToBounds="True" Margin="0,0,0,8">
        <Canvas>
          <Border x:Name="Bar" Height="4" Width="140" CornerRadius="2" Background="{DynamicResource DebloatAccent}" />
        </Canvas>
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="2" Padding="32,0,32,24">
      <StackPanel>
        <!-- Pré-requisitos numa linha só: não há o que abrir. -->
        <Border BorderBrush="{DynamicResource DebloatBorder}" BorderThickness="0,0,0,1" MinHeight="56" Padding="0,8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Runtimes}" VerticalAlignment="Center" Foreground="{DynamicResource DebloatMuted}" />
            <TextBlock Text="Pré-requisitos de jogos e programas" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource DebloatText}" />
          </DockPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Apps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource DebloatBorder}" BorderThickness="0,0,0,1" MinHeight="56" Padding="0,8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource DebloatMuted}" />
                    <ui:Button Content="Abrir" Command="{Binding OpenCommand}" Margin="0,0,8,0"
                               Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Fixar no Iniciar" Icon="{ui:SymbolIcon Pin24}" Command="{Binding PinCommand}"
                               Visibility="{Binding CanPin, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource DebloatText}" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</ui:FluentWindow>
